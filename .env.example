# ---------------------------------------------------------------------------
# Environment contract. Every variable is documented: where to get it, and what
# an empty value means. Copy to .env for local development.
# ---------------------------------------------------------------------------

# Deployment environment. Defaults to "production" on purpose so that a missing
# variable fails closed rather than silently enabling development behaviour.
ENVIRONMENT=development

# Postgres. Locally this is the docker-compose service (see docker-compose.yml).
# Railway provides postgresql://...; the app rewrites the scheme to +asyncpg.
DATABASE_URL=postgresql://cvagent:cvagent@localhost:5433/cvagent

# The bearer token the Reto IA platform sends as `Authorization: Bearer <key>`.
# Registered in Agentes -> Añadir un agente -> "Clave de API".
# EMPTY MEANS THE API REFUSES EVERY REQUEST, in every environment. There is no
# development bypass: an unset secret must never mean "open".
AGENT_API_KEY=

# LLM provider. Anthropic is the default; the adapter is swappable.
# A pay-as-you-go API key is required — a Claude Code Max subscription does NOT
# grant API access.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_S=45

# Embeddings provider: "openai" or "voyage". Only needed for the dense and
# hybrid retrieval modes; ignored for context/structured modes.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Retrieval mode: context | structured | dense | hybrid
# This is the ladder switch. One pipeline, four modes, one evaluation set.
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20

# Safety / cost ceilings.
MAX_TOOL_ITERATIONS=6
RATE_LIMIT_PER_MINUTE=30
