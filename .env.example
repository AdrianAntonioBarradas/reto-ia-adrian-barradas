# ---------------------------------------------------------------------------
# Environment contract.
#
# This file is COMMITTED and PUBLIC. It documents which variables exist, where to
# obtain each one, and what an empty value means. It never carries a value for a
# *_KEY / *_TOKEN / *_SECRET variable — tests/unit/test_env_example_has_no_secrets.py
# fails the build if one appears here.
#
# Copy to .env (gitignored) and fill in the blanks for local development.
# ---------------------------------------------------------------------------

# Deployment environment: development | production
# Defaults to "production" in code on purpose, so a missing variable fails closed.
ENVIRONMENT=development

# --- Public API ------------------------------------------------------------
# The bearer token the Reto IA platform sends as `Authorization: Bearer <key>`.
# You choose this value, then paste the same one into
# Agentes -> Añadir un agente -> "Clave de API".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# EMPTY MEANS THE API REFUSES EVERY REQUEST, in every environment. There is no
# development bypass: an unset secret must never be read as "open".
AGENT_API_KEY=

# Used to build absolute URLs in the agent card and the root document.
PUBLIC_BASE_URL=http://localhost:8000
AGENT_NAME="Adrián Barradas — Agente de CV"

# --- LLM -------------------------------------------------------------------
# Two adapters behind one interface. Pick with LLM_PROVIDER.
#
#   LLM_PROVIDER=openai_compatible   (default)
#     Google AI Studio  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                       LLM_MODEL=gemini-3.5-flash   key: aistudio.google.com/apikey
#                       NOTE: the free tier allows 20 requests per DAY per model.
#                       Enough to try it; not enough to run an evaluation or a demo.
#     Cerebras          LLM_BASE_URL=https://api.cerebras.ai/v1
#                       LLM_MODEL=qwen-3.8-27b       key: cloud.cerebras.ai (needs billing)
#     Groq              LLM_BASE_URL=https://api.groq.com/openai/v1
#     OpenAI            LLM_BASE_URL=https://api.openai.com/v1
#
#   LLM_PROVIDER=anthropic
#     Native SDK; LLM_BASE_URL is ignored. key: console.anthropic.com
#     LLM_MODEL=claude-sonnet-5  (or claude-haiku-4-5 for simple, high-volume calls)
#     A Claude Code Max subscription does NOT grant API access — this needs a
#     pay-as-you-go key with credit.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Thinking tokens count against this, so leave headroom past the visible answer.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=45
# Anthropic only: thinking depth (low | medium | high | xhigh | max).
LLM_EFFORT=low

# --- Embeddings ------------------------------------------------------------
# Local ONNX (fastembed). No API key, no network hop on the read path, and
# deterministic vectors so the retrieval evaluation is reproducible.
# EMBEDDINGS_DIM must match the model; a mismatch corrupts the index silently,
# so the embedder refuses to start rather than let that happen.
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384
# Where the ONNX weights live. Populated at build time by scripts/warm_model.py
# so a cold container never downloads 220 MB on its first request.
EMBEDDINGS_CACHE_DIR=.fastembed_cache
# onnxruntime allocates a memory arena per intra-op thread. One is plenty for a
# 135-vector index, and the default (one per vCPU) was enough to get the container
# OOM-killed against a 1 GB limit.
EMBEDDINGS_THREADS=1

# --- Retrieval -------------------------------------------------------------
# The ladder switch: one pipeline, four modes, one evaluation set.
#   context    full curated profile in the prompt, no retrieval  (baseline)
#   structured typed tool lookups only, no vectors
#   dense      pgvector cosine search
#   hybrid     dense + Postgres full-text, fused with reciprocal rank fusion
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20

# --- Ceilings --------------------------------------------------------------
MAX_TOOL_ITERATIONS=6
RATE_LIMIT_PER_MINUTE=30
