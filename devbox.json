{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "uv": "",
    "python": "3.12",
    "nodejs_22": ""
  },
  "shell": {
    "init_hook": [
      "export LD_LIBRARY_PATH=\"$DEVBOX_PACKAGES_DIR/lib:${LD_LIBRARY_PATH:-}\"",
      "echo 'cv-agent | devbox run: dev | check | test | eval | eval-retrieval | warm'"
    ],
    "scripts": {
      "dev": [
        "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
      ],
      "check": [
        "uv run ruff check .",
        "uv run ruff format --check .",
        "uv run mypy .",
        "uv run pytest"
      ],
      "fmt": [
        "uv run ruff format .",
        "uv run ruff check --fix ."
      ],
      "test": [
        "uv run pytest"
      ],
      "eval": [
        "uv run python -m scripts.eval_answers --write"
      ],
      "warm": [
        "uv run python -m scripts.warm_model"
      ],
      "eval-retrieval": [
        "uv run python -m scripts.eval_retrieval --write"
      ]
    }
  }
}
