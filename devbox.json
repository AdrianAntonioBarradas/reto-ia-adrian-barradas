{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "uv": "",
    "python": "3.12",
    "nodejs_22": ""
  },
  "shell": {
    "init_hook": [
      "export LD_LIBRARY_PATH=\"$DEVBOX_PACKAGES_DIR/lib:${LD_LIBRARY_PATH:-}\"",
      "export UV_PYTHON=\"$(command -v python3.12 || command -v python3)\"",
      "echo 'cv-agent | devbox run: dev | check | test | eval | ingest | index | db-up'"
    ],
    "scripts": {
      "dev":     ["uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"],
      "check":   ["uv run ruff check .", "uv run ruff format --check .", "uv run mypy .", "uv run pytest"],
      "fmt":     ["uv run ruff format .", "uv run ruff check --fix ."],
      "test":    ["uv run pytest"],
      "eval":    ["uv run python -m scripts.eval"],
      "ingest":  ["uv run python -m scripts.ingest"],
      "index":   ["uv run python -m scripts.index"],
      "migrate": ["uv run alembic upgrade head"],
      "db-up":   ["docker compose up -d"],
      "db-down": ["docker compose down"]
    }
  }
}
